# Server-only secret. Copy this file to server/.env and replace the value locally.
OPENAI_API_KEY=
# Configurable text/vision model supporting Responses structured output.
ERECIPE_OPENAI_MODEL=gpt-6-luna
# Application HTTPS origin printed by tailscale serve status (not the reader LAN URL).
# May instead be supplied with --app-origin. Leave blank for LAN-only experiments.
ERECIPE_APP_ORIGIN=
