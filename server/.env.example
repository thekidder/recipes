# Server-only settings. Copy to server/.env and fill credentials locally.
# Select exactly one provider: openai (default) or openrouter.
ERECIPE_LLM_PROVIDER=openai
OPENAI_API_KEY=
# Configurable text/vision model supporting Responses structured output.
ERECIPE_OPENAI_MODEL=gpt-6-luna
# OpenRouter requires its own key and an explicit model ID from its catalog.
# Choose a model with structured outputs; image shares also need image input.
OPENROUTER_API_KEY=
ERECIPE_OPENROUTER_MODEL=
# Application HTTPS origin printed by tailscale serve status (not the reader LAN URL).
# May instead be supplied with --app-origin. Leave blank for LAN-only experiments.
ERECIPE_APP_ORIGIN=

# Optional calendar fallback from your hosted TRMNL device (Developer access).
# Its cloud playlist should contain only your calendar/weather screen.
# Keep this distinct from the local reader API key. Empty disables cloud fetching.
ERECIPE_TRMNL_API_KEY=
